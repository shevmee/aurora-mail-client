/**
 * @file OAuthCredentials.hpp
 * @brief OAuth credentials configuration.
 * 
 * This file is generated by CMake from OAuthCredentials.hpp.in
 * DO NOT edit this file directly - edit OAuthCredentials.hpp.in instead.
 * 
 * Credentials can be provided via:
 * 1. CMake variables: -DOAUTH_CLIENT_ID=xxx -DOAUTH_CLIENT_SECRET=xxx
 * 2. Environment variables at runtime: AURORA_OAUTH_CLIENT_ID, AURORA_OAUTH_CLIENT_SECRET
 * 
 * Note: While PKCE secures the initial authorization, Google still requires
 * client_secret for refresh token requests.
 * 
 * For Google OAuth Desktop App:
 * - Go to https://console.cloud.google.com/
 * - Create OAuth 2.0 Client ID (Desktop application type)
 * - Copy both Client ID and Client Secret
 */

#ifndef AURORA_OAUTH_CREDENTIALS_HPP
#define AURORA_OAUTH_CREDENTIALS_HPP

#include <QString>
#include <QProcessEnvironment>

namespace aurora::mail::app::config {

/**
 * @brief OAuth credentials provider with compile-time and runtime fallback.
 */
class OAuthCredentials {
public:
    /**
     * @brief Get OAuth Client ID.
     * 
     * Priority: compile-time value > environment variable AURORA_OAUTH_CLIENT_ID
     */
    static QString clientId() {
        // Compile-time value from CMake (empty string if not set)
        static const QString compiledId = QStringLiteral("@OAUTH_CLIENT_ID@");
        
        if (!compiledId.isEmpty()) {
            return compiledId;
        }
        
        // Runtime fallback: environment variable
        return QProcessEnvironment::systemEnvironment()
            .value(QStringLiteral("AURORA_OAUTH_CLIENT_ID"));
    }
    
    /**
     * @brief Get OAuth Client Secret.
     * 
     * Required for refresh token requests (Google requirement).
     */
    static QString clientSecret() {
        // Compile-time value from CMake (empty string if not set)
        static const QString compiledSecret = QStringLiteral("@OAUTH_CLIENT_SECRET@");
        
        if (!compiledSecret.isEmpty()) {
            return compiledSecret;
        }
        
        // Runtime fallback: environment variable
        return QProcessEnvironment::systemEnvironment()
            .value(QStringLiteral("AURORA_OAUTH_CLIENT_SECRET"));
    }
    
    /**
     * @brief Check if OAuth is configured.
     */
    static bool isConfigured() {
        return !clientId().isEmpty() && !clientSecret().isEmpty();
    }
    
    /**
     * @brief Get user-friendly error message if credentials are missing.
     */
    static QString getMissingCredentialsMessage() {
        if (isConfigured()) {
            return QString();
        }
        
        QStringList missing;
        if (clientId().isEmpty()) {
            missing << QStringLiteral("AURORA_OAUTH_CLIENT_ID");
        }
        if (clientSecret().isEmpty()) {
            missing << QStringLiteral("AURORA_OAUTH_CLIENT_SECRET");
        }
        
        return QStringLiteral(
            "OAuth credentials not configured.\n\n"
            "Missing: %1\n\n"
            "Set environment variables or rebuild with:\n"
            "  cmake -DOAUTH_CLIENT_ID=xxx -DOAUTH_CLIENT_SECRET=xxx ..\n\n"
            "Get credentials at: https://console.cloud.google.com/"
        ).arg(missing.join(QStringLiteral(", ")));
    }

private:
    OAuthCredentials() = delete; // Static class
};

} // namespace aurora::mail::app::config

#endif // AURORA_OAUTH_CREDENTIALS_HPP

#---------------------------------------------------------------------------
# Aurora Mail — engine module Doxyfile
#
# Generates HTML reference documentation for the engine library
# (AuroraMailEngine + its CLI). Run from the repo root or from `engine/`:
#
#   doxygen engine/Doxyfile
#
# Output goes to engine/docs/html/. Keep this file in sync with the source
# layout under engine/libs/.
#---------------------------------------------------------------------------

# --- Project ----------------------------------------------------------------
PROJECT_NAME           = "Aurora Mail — Engine"
PROJECT_NUMBER         = 1.0.0
PROJECT_BRIEF          = "Portable IMAP/SMTP/MIME engine (C++23, Boost.Asio coroutines)"
PROJECT_LOGO           =
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO
ALLOW_UNICODE_NAMES    = YES
OUTPUT_LANGUAGE        = English
BRIEF_MEMBER_DESC      = YES
REPEAT_BRIEF           = YES
ALWAYS_DETAILED_SEC    = NO
INLINE_INHERITED_MEMB  = NO
FULL_PATH_NAMES        = NO
TAB_SIZE               = 2
JAVADOC_AUTOBRIEF      = YES
QT_AUTOBRIEF           = YES
MULTILINE_CPP_IS_BRIEF = NO
INHERIT_DOCS           = YES
SEPARATE_MEMBER_PAGES  = NO
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 4
AUTOLINK_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
NUM_PROC_THREADS       = 0
TIMESTAMP              = DATETIME

# Make IMAP system-flag names (\Seen, \Deleted, \Recent, \Noselect,
# \HasNoChildren, ...) and CRLF mentions (\r, \n) render as literal text
# instead of being parsed as unknown Doxygen commands. Each alias maps the
# token name to a backslash-prefixed literal; the @ prefix below means the
# alias is invoked as @Deleted, but Doxygen also recognises the bare \Deleted
# form that already exists in the source comments.
ALIASES                = "Seen=\\Seen" \
                         "Deleted=\\Deleted" \
                         "Answered=\\Answered" \
                         "Flagged=\\Flagged" \
                         "Draft=\\Draft" \
                         "Recent=\\Recent" \
                         "Noselect=\\Noselect" \
                         "Noinferiors=\\Noinferiors" \
                         "Marked=\\Marked" \
                         "Unmarked=\\Unmarked" \
                         "HasChildren=\\HasChildren" \
                         "HasNoChildren=\\HasNoChildren" \
                         "r=\\r" \
                         "n=\\n" \
                         "t=\\t" \
                         "ndata=\\ndata"

# --- Coverage ---------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
HIDE_FRIEND_COMPOUNDS  = NO
HIDE_IN_BODY_DOCS      = NO
INTERNAL_DOCS          = NO
CASE_SENSE_NAMES       = YES
HIDE_SCOPE_NAMES       = NO
SHOW_INCLUDE_FILES     = YES
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES

# Don't pollute the output with verbose generated/Qt-internal warnings; keep
# real undocumented-symbol warnings on so we can monitor coverage drift.
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = NO
WARN_LOGFILE           = docs/doxygen-warnings.log

# --- Inputs -----------------------------------------------------------------
INPUT                  = ../docs/mainpage.md \
                         libs/Common \
                         libs/ResponseHandling \
                         libs/ImapCommand/include \
                         libs/SmtpCommand/include \
                         MailClient \
                         Cli
USE_MDFILE_AS_MAINPAGE = ../docs/mainpage.md
INPUT_ENCODING         = UTF-8
FILE_PATTERNS          = *.hpp *.cpp *.h *.c *.md
RECURSIVE              = YES
EXCLUDE                =
EXCLUDE_PATTERNS       = */test/* */tests/* */build*/* */docs/*
EXCLUDE_SYMBOLS        =
EXAMPLE_PATH           =
IMAGE_PATH             =
INPUT_FILTER           =
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = YES
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES
REFERENCES_LINK_SOURCE = YES
USE_HTAGS              = NO
VERBATIM_HEADERS       = YES

# --- Alphabetical Index -----------------------------------------------------
ALPHABETICAL_INDEX     = YES

# --- HTML output (with doxygen-awesome theme) ------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html

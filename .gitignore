# Build
build/
cmake-build-*/
out/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
compile_commands.json
*.user

# CTest / CDash (auto-generated by CMake when project enables CTest)
DartConfiguration.tcl
Testing/

# Coverage / profiling (auto-generated when running clang/llvm
# instrumented binaries; merge with `llvm-profdata` then delete).
*.profraw
*.profdata
*.gcda
*.gcno

# Qt / generated
*_autogen/
moc_*.cpp
qrc_*.cpp
ui_*.h

# IDE
.idea/
.vscode/*.log
.cache/
.qt/

# OS
.DS_Store

# Generated Doxygen output (engine/Doxyfile and desktop/Doxyfile write here).
# The mainpage and the vendored doxygen-awesome theme under docs/ are kept.
engine/docs/
desktop/docs/

# Personal notes / scratch (never commit)
text.md
text.md.recovered.bak

# AuroraMail: diagnostics from headers under engine/ and desktop/ only (HeaderFilterRegex).
# Translation units are filtered by CMake (run-clang-tidy -source-filter). Omit clang-analyzer-* here
# to avoid huge noise from SDK/Qt system headers; enable it in CI if desired.
---
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-reserved-identifier,
  -bugprone-suspicious-include,
  cert-*,
  -cert-err58-cpp,
  misc-unused-imports,
  performance-*,
  portability-*,
  readability-braces-around-statements,
  readability-container-size-empty,
  readability-delete-null-pointer,
  readability-implicit-bool-conversion,
  readability-non-const-parameter

WarningsAsErrors: ''
HeaderFilterRegex: '.*/(engine|desktop)/.*'
FormatStyle: file

CheckOptions:
  - key: readability-braces-around-statements.ShortStatementLines
    value: '3'
  - key: readability-implicit-bool-conversion.AllowPointerConditions
    value: 'false'
    